# API Provider Configuration
# Options: 'google' or 'openrouter'
NEXT_PUBLIC_API_PROVIDER=google

# Google Gemini API Configuration (used when NEXT_PUBLIC_API_PROVIDER=google)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Configuration (used when NEXT_PUBLIC_API_PROVIDER=openrouter)
NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
NEXT_PUBLIC_OPENROUTER_MODEL=google/gemini-flash-1.5
